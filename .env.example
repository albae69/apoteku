# --- API ---
PORT=4000
# MySQL / MariaDB connection string
DATABASE_URL=mysql://root:root@127.0.0.1:3306/apoteku
# Change this in production
JWT_SECRET=dev-secret-change-me
# Allowed origin for the web app (CORS)
WEB_ORIGIN=http://localhost:5173
# MySQL connection pool size
DB_POOL_SIZE=20

# --- Audit log (berkas harian) ---
AUDIT_ENABLED=true
# Direktori berkas audit (relatif ke apps/api). Satu file per hari: audit-YYYY-MM-DD.log
AUDIT_DIR=./logs/audit
# Umur simpan berkas audit dalam hari (0 = simpan selamanya)
AUDIT_RETENTION_DAYS=90
# true = permintaan baca (GET) juga dicatat
AUDIT_LOG_READS=false

# --- Web (Vite) ---
VITE_API_URL=http://localhost:4000
